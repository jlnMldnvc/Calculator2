<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    android:orientation="vertical"
    android:padding="@dimen/layout_padding"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:maxLines="3"
            android:paddingEnd="10dp"
            android:textSize="@dimen/display_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:orientation="horizontal">

        <Button
            android:id="@+id/plusButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/colorLightButtons"
            android:onClick="handleArithmeticButtonClick"
            android:text="@string/plus" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/minusButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorLightButtons"
            android:onClick="handleArithmeticButtonClick"
            android:text="@string/minus" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/multiplyButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorLightButtons"
            android:onClick="handleArithmeticButtonClick"
            android:text="@string/multiply" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/divideButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorLightButtons"
            android:onClick="handleArithmeticButtonClick"
            android:text="@string/divide" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorRedButtons"
            android:onClick="handleClearButtonClick"
            android:text="@string/clear" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal">

        <Button
            android:id="@+id/sevenButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/seven"
            android:textSize="@dimen/numbers_text_size" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/eightButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/eight"
            android:textSize="@dimen/numbers_text_size" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/nineButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/nine"
            android:textSize="@dimen/numbers_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal">

        <Button
            android:id="@+id/fourButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/four"
            android:textSize="@dimen/numbers_text_size" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/fiveButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/five"
            android:textSize="@dimen/numbers_text_size" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/sixButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/six"
            android:textSize="@dimen/numbers_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal">

        <Button
            android:id="@+id/oneButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/one"
            android:textSize="@dimen/numbers_text_size" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/twoButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/two"
            android:textSize="@dimen/numbers_text_size" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/threeButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/three"
            android:textSize="@dimen/numbers_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dotButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/dot"
            android:textSize="@dimen/numbers_text_size" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/zeroButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorButtons"
            android:onClick="handleNumericButtonClick"
            android:text="@string/zero"
            android:textSize="@dimen/numbers_text_size" />

        <Space
            android:layout_width="@dimen/views_gap"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/equalButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorGreenButtons"
            android:onClick="handleEqualsButtonClick"
            android:text="@string/equal"
            android:textSize="@dimen/numbers_text_size" />
    </LinearLayout>
</LinearLayout>